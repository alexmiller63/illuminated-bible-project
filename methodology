# Illuminated Bible Project

# Methodology Specification

#

# This file preserves the editorial methodology developed through

# conversation between Alexander Ferrari Miller and Heather.

#

# Status:

#   This is a reconstruction of the mature methodology established so far.

#   It must not silently replace, simplify, or contradict earlier decisions.

#   Missing details must be marked as unresolved rather than invented.

specification:

  title: "Illuminated Bible Methodology"

  project: "Illuminated Bible Project"

  version: "0.1"

  status: "working authoritative draft"

  format: "YAML"

  author_editor: "Alexander Ferrari Miller"

  collaborator: "Heather"

  preservation_project: "Elephant"

governing_principles:

  faithful_preservation:

    rule: >

      Preserve established editorial decisions faithfully.

      Do not revert to an earlier methodology merely because it is

      easier to reconstruct or generate.

    priority: "highest"

  frozen_means_frozen:

    rule: >

      Once a version is declared frozen, it remains the baseline.

      Later changes must be recorded as new revisions rather than

      silently altering the frozen version.

  uncertainty:

    rule: >

      When a detail is unknown or lost, mark it as unresolved.

      Do not invent a replacement and present it as established.

  conversation_and_document:

    conversation:

      purpose: >

        Preserve the history, reasoning, alternatives, corrections,

        and development of the methodology.

    materialized_document:

      purpose: >

        Preserve the current settled methodology in a concise,

        authoritative form.

    relationship: >

      The conversation preserves how and why decisions were reached.

      This YAML document preserves what the current decisions are.

editorial_vision:

  unit_of_work:

    type: "individual Bible verse"

    rule: >

      Each verse is treated as a distinct editorial and reading unit.

  objective:

    - "Illuminate the meaning of Scripture."

    - "Preserve the underlying biblical text."

    - "Make the structure understandable to the reader."

    - "Support careful reading rather than decoration for its own sake."

    - "Create a durable form that can be reproduced consistently."

  illumination:

    meaning: >

      Illumination is an editorial rendering that clarifies and reveals

      the meaning and structure of the verse.

    not_merely:

      - "ornament"

      - "decorative artwork"

      - "a paraphrase detached from its textual foundation"

translation_sources:

  permitted_foundations:

    - abbreviation: "WEB"

      name: "World English Bible"

    - abbreviation: "BEB"

      name: "Basic English Bible"

  selection:

    rule: >

      For each illuminated verse, the editor chooses either WEB or BEB

      as its foundation according to editorial judgment.

    criterion: >

      Choose the translation that provides the best foundation for

      illuminating the meaning of that particular verse.

    fixed_global_default: false

  distinction:

    rule: >

      The translation chosen as the foundation of the illuminated verse

      may be WEB or BEB, but the separate quotation immediately below the

      illuminated verse is the WEB verse.

canonical_verse_sequence:

  order:

    - source_label

    - illuminated_verse

    - web_foundation_verse

    - hebrew_interlinear

    - hebrew_transliteration

  adjacency_rules:

    illuminated_to_web:

      rule: >

        The WEB foundation verse must appear directly beneath the

        illuminated verse.

      intervening_content_allowed: false

    interlinear_and_transliteration:

      rule: >

        The Hebrew interlinear and transliteration belong to the verse

        unit and must not be omitted from the canonical prototype.

source_label:

  position: "before the illuminated verse"

  allowed_values:

    - "WEB"

    - "BEB"

  meaning: >

    The label identifies which translation served as the foundation

    for the illuminated verse.

  applies_to:

    - "illuminated_verse"

  does_not_apply_to:

    - "web_foundation_verse"

  visibility:

    illuminated_verse: true

    web_foundation_verse: false

illuminated_verse:

  role: >

    The illuminated verse is the editorially illuminated rendering of

    the biblical verse.

  foundation:

    allowed:

      - "WEB"

      - "BEB"

    identified_by: "source_label"

  content_method:

    rule: >

      The illuminated rendering may bring forward significant Hebrew

      terms, meanings, relationships, or structure where editorially

      appropriate.

    example_pattern:

      status: "illustrative, not a complete frozen verse"

      text: "In the beginning — Hebrew: ... — Elohim, God, created ..."

  artwork:

    inside_verse: false

    rule: >

      The illuminated verse itself must contain no artwork.

  drop_cap:

    allowed: false

  typography:

    purpose: >

      Typography may establish hierarchy and readability, but must not

      substitute decoration for meaning.

  fidelity:

    rule: >

      The illuminated verse must remain visibly grounded in its selected

      source translation and must not become an unrelated creative rewrite.

web_foundation_verse:

  translation: "WEB"

  role: >

    Present the World English Bible wording as the textual foundation

    immediately below the illuminated verse.

  position: "directly below illuminated_verse"

  label:

    visible: false

    rule: >

      Do not place a second WEB label before the WEB quotation.

  wording:

    treatment: "verbatim"

    editorial_rewriting_allowed: false

  artwork:

    inside_verse: false

hebrew_interlinear:

  required: true

  language: "Biblical Hebrew"

  role: >

    Show the Hebrew text in an interlinear form that helps the reader

    connect the Hebrew wording with its meaning.

  position:

    after: "web_foundation_verse"

    before: "hebrew_transliteration"

  omission_allowed: false

  detailed_format:

    status: "unresolved"

    note: >

      Exact word alignment, punctuation, gloss placement, and handling of

      Hebrew reading direction must be recovered or formally established.

hebrew_transliteration:

  required: true

  role: >

    Provide a readable transliteration of the Hebrew associated with

    the verse.

  position:

    after: "hebrew_interlinear"

  omission_allowed: false

  transliteration_system:

    status: "unresolved"

    note: >

      The exact transliteration standard and treatment of divine names,

      vowel sounds, and grammatical forms must be specified without

      inventing rules.

visual_methodology:

  governing_rule: >

    Visual design must serve comprehension, memory, reverence, and the

    meaning of the verse.

  illuminated_verse_area:

    artwork_allowed: false

    drop_cap_allowed: false

  surrounding_page:

    artwork_allowed: "only when purposefully designed and approved"

    rule: >

      Artwork elsewhere on a page must support the verse rather than

      overwhelm, replace, or obscure the textual methodology.

  hierarchy:

    required_distinctions:

      - "source label"

      - "illuminated verse"

      - "WEB foundation verse"

      - "Hebrew interlinear"

      - "Hebrew transliteration"

  consistency:

    rule: >

      A reader should be able to recognize the same functional structure

      from verse to verse even when individual illumination decisions vary.

reference_prototype:

  purpose: >

    Demonstrate the mature methodology visually and structurally so that

    future renderings do not have to reconstruct it from memory.

  intended_contents:

    - "cover"

    - "spine"

    - "front matter"

    - "preface"

    - "foreword"

    - "sample Bible pages"

    - "Genesis sample verses"

  genesis_sample:

    planned_scope:

      start: "Genesis 1:1"

      verse_count: 5

    requirement: >

      Every sample verse must follow the complete canonical verse sequence.

  status:

    existing_visual_versions: >

      Earlier visual mockups exist, but later generated images may have

      lost substantial methodology.

    rule: >

      A visually attractive reconstruction is not authoritative unless it

      conforms to this specification.

front_matter:

  established_order:

    - "cover"

    - "spine"

    - "preface"

    - "foreword"

    - "sample material"

  note: >

    The preface belongs before the explanatory README when presenting the

    project to a reader.

  detailed_page_order:

    status: "partially established"

    action: >

      Recover and verify the complete front-matter sequence before freezing.

validation_rules:

  failures:

    - id: "V001"

      condition: "The source label is absent from an illuminated verse."

      severity: "error"

    - id: "V002"

      condition: "The source label contains a value other than WEB or BEB."

      severity: "error"

    - id: "V003"

      condition: >

        The WEB foundation verse does not immediately follow the

        illuminated verse.

      severity: "error"

    - id: "V004"

      condition: "The WEB foundation quotation displays a second WEB label."

      severity: "error"

    - id: "V005"

      condition: "Artwork appears inside the illuminated verse."

      severity: "error"

    - id: "V006"

      condition: "A drop cap appears in the illuminated verse."

      severity: "error"

    - id: "V007"

      condition: "The Hebrew interlinear is omitted."

      severity: "error"

    - id: "V008"

      condition: "The Hebrew transliteration is omitted."

      severity: "error"

    - id: "V009"

      condition: >

        An unresolved methodological detail is silently replaced by an

        invented rule.

      severity: "critical"

    - id: "V010"

      condition: >

        A new rendering reverts to an obsolete version of the methodology.

      severity: "critical"

revision_control:

  repository_role: >

    GitHub is the durable repository for the methodology, prototypes,

    source texts, images, and revision history.

  change_policy:

    - "Every meaningful change receives a commit."

    - "Commit messages should describe the methodological change."

    - "Do not overwrite a frozen version without creating a new revision."

    - "Images are outputs; this YAML specification is part of the source."

    - "The reference prototype must identify the specification version used."

  suggested_commit_message: >

    Add initial YAML specification for mature illuminated-verse methodology

unresolved_items:

  rule: >

    These items must be recovered or decided explicitly.

    Their presence here must not be mistaken for permission to improvise.

  items:

    - "Exact Hebrew interlinear layout"

    - "Exact transliteration standard"

    - "Complete typography specification"

    - "Page dimensions and margins"

    - "Complete front-matter order"

    - "Cover and spine specifications"

    - "Rules governing approved surrounding artwork"

    - "Exact illuminated text for Genesis 1:1–1:5"

    - "Handling of punctuation and capitalization"

    - "Treatment of divine names"

    - "Citation and attribution format"

    - "Versioning rules for individual verses"

preservation_statement: >

  The purpose of this specification is to prevent the mature methodology

  from being lost, simplified, or repeatedly reconstructed. Future work

  must begin from this document and its preserved revisions, not from a

  fresh approximation.